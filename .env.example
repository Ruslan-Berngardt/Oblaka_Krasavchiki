# Локальная учебная конфигурация. Для запуска через Compose достаточно скопировать в .env.
POSTGRES_USER=kadr
POSTGRES_PASSWORD=kadr_local_password
POSTGRES_DB=kadr
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kadr:kadr_local_password@localhost:5432/kadr
PORT=3000
# Включите true только при работе через HTTPS.
COOKIE_SECURE=false
